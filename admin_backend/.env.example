# Sentra Parking System - Backend Environment Variables
# Copy this file to .env and fill in your actual credentials.
# Never commit the real .env file.

# Supabase Configuration
# Get these from: https://supabase.com → Your Project → Settings → API
# The backend is a trusted server, so it uses the SERVICE ROLE key.
# Never put the service role key in the mobile app or React frontend.
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_service_role_key_here

# Shared secret the SentraAI service sends in the X-Service-Key header.
# Must be identical in Sentra-AI-Model/service/.env.
# Generate with: openssl rand -hex 32
SERVICE_API_KEY=replace_with_a_long_random_secret

# Stripe secret key (wallet top-ups). Leave empty to disable Stripe endpoints.
STRIPE_SECRET_KEY=

# SentraAI service URL (Docker: http://sentra-ai-service:5001)
LPR_SERVICE_URL=http://127.0.0.1:5001

# Example:
# SUPABASE_URL=https://abcdefghijk.supabase.co
# SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
